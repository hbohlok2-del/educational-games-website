<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Course Notes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Cairo:wght@400;600;700;800&family=Nunito:wght@400;600;700;800&display=swap">
<link rel="stylesheet" href="/vendor/katex/katex.min.css">
<link rel="stylesheet" href="/shared/tokens.css">
<link rel="stylesheet" href="/shared/site.css">
<link rel="stylesheet" href="/lessons.css">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true" dir="ltr">eg.</span><span class="brand-name" data-i18n="hub.title">Educational Games</span></a>
    <div class="lang-links" role="group" aria-label="Language">
      <button type="button" data-lang="en" lang="en">EN</button>
      <button type="button" data-lang="fr" lang="fr">FR</button>
      <button type="button" data-lang="pl" lang="pl">PL</button>
      <button type="button" data-lang="ar" lang="ar">العربية</button>
    </div>
  </div>
</header>
<nav class="site-nav">
  <div class="wrap">
    <a href="/" data-i18n="hub.nav.home">Home</a>
    <a href="/play/" data-i18n="hub.nav.play">Play</a>
    <a href="/teacher/" data-i18n="hub.nav.create">Create</a>
    <a href="/lessons/" aria-current="page" data-i18n="hub.nav.notes">Course Notes</a>
  </div>
</nav>
<main class="notes-main">
<%- body %>
</main>
<footer class="site-footer">
  <div class="wrap">
    <span data-i18n="hub.footer.left">Educational Games · Made for classroom curiosity.</span>
    <span data-i18n="hub.footer.right">Learn together. Play kindly.</span>
  </div>
</footer>
<script src="/shared/i18n/dictionaries.js"></script>
<script src="/shared/i18n.js"></script>
<script src="/vendor/katex/katex.min.js"></script>
<script src="/vendor/katex/contrib/auto-render.min.js"></script>
<script src="/vendor/katex/contrib/mhchem.min.js"></script>
<script src="/shared/mathRender.js"></script>
<script>
  renderMathIn(document.body);
</script>
<script src="/lessons.js"></script>
</body>
</html>
