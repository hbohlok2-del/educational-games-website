<article class="lesson">
  <p class="eyebrow"><a href="/lessons/" data-i18n="lessons.nav">Course Notes</a> / <a href="/lessons/<%= subject %>/" data-i18n="lessons.subjects.<%= subject %>"><%= subject %></a></p>
  <h1><%= lesson.title %></h1>
  <% if (lesson.summary) { %><p class="lesson-summary-lead"><%= lesson.summary %></p><% } %>
  <div class="lesson-body">
    <%- lesson.html %>
  </div>
</article>
