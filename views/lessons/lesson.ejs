<article class="note">
  <header class="note-band">
    <div class="wrap">
      <p class="eyebrow"><a href="/lessons/" data-i18n="lessons.nav">Course Notes</a> / <a href="/lessons/<%= subject %>/" data-i18n="lessons.subjects.<%= subject %>"><%= subject %></a></p>
      <h1 lang="en" dir="ltr"><%= lesson.title %></h1>
      <div class="note-meta">
        <p><% if (lesson.summary) { %><span lang="en" dir="ltr"><%= lesson.summary %></span> <% } %><span class="note-time" id="readTime"></span></p>
        <a class="note-all" href="/lessons/"><span class="arrow back" aria-hidden="true">&larr;</span> <span data-i18n="lessons.allNotes">All Course Notes</span></a>
      </div>
    </div>
  </header>
  <div class="note-paper">
    <div class="wrap note-grid">
      <nav class="note-toc hidden" id="noteTocNav" aria-labelledby="noteTocTitle">
        <p class="note-toc-title" id="noteTocTitle" data-i18n="lessons.inThisNote">In this note</p>
        <ol id="noteToc" lang="en" dir="ltr"></ol>
      </nav>
      <div class="lesson-body" id="lessonBody" lang="en" dir="ltr">
        <%- lesson.html %>
      </div>
      <aside class="note-side">
        <div class="card play-card">
          <p class="eyebrow" data-i18n="lessons.play.eyebrow">Learn → Play</p>
          <h2 data-i18n="lessons.play.title">Put the idea into play.</h2>
          <p data-i18n="lessons.play.desc">Turn this note into a team game for your class.</p>
          <a class="btn-primary" href="/teacher/"><span data-i18n="lessons.play.button">Open the editor</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </aside>
    </div>
  </div>
</article>
